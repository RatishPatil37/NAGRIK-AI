# Nagrik AI Environment Variables Template
# Copy this file to .env and insert your real API keys/credentials

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_MODEL=gemini-3.7-flash
SECONDARY_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=your_groq_api_key_here
FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=municipal_knowledge

# Supabase Auth & PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Server Environment & Safety Limits
ENVIRONMENT=development
TESTING=False
MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_ANON_RPM=10
RATE_LIMIT_AUTH_RPM=30
